// BinKılıç Saklı Bahçe — veritabanı şeması (PostgreSQL)
generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Kullanıcılar & Yetkiler ─────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  active       Boolean   @default(true)
  preferences  Json      @default("{}")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  auditLogs    AuditLog[]
  reservationNotes ReservationNote[]
  eventNotes   EventRequestNote[]

  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique // admin | manager | staff | özel
  name        String
  description String?
  system      Boolean          @default(false)
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // ör. "menu.manage"
  name        String
  group       String
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String?
  userAgent  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginLog {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_logs")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // create | update | delete | status | login | logout | export | backup
  entity    String
  entityId  String?
  summary   String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model ErrorLog {
  id        String   @id @default(cuid())
  source    String
  message   String
  stack     String?
  path      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("error_logs")
}

// ───────────────────────── İçerik & Ayarlar ─────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Page {
  id             String   @id @default(cuid())
  key            String   @unique // home | about | gallery | organization | contact | menu | campaigns | reservation
  title          String
  slug           String   @unique
  content        Json     @default("{}")
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  ogImage        String?
  canonical      String?
  noindex        Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  @@map("pages")
}

model SpecialDay {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  type      String // holiday | special | closure
  title     String
  closed    Boolean  @default(false)
  open      String?
  close     String?
  createdAt DateTime @default(now())

  @@unique([date])
  @@map("special_days")
}

// ───────────────────────── Menü ─────────────────────────

model Category {
  id           String                @id @default(cuid())
  slug         String                @unique
  name         String
  description  String?
  image        String?
  icon         String?
  parentId     String?
  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]            @relation("CategoryTree")
  sortOrder    Int                   @default(0)
  active       Boolean               @default(true)
  availableFrom String? // "08:00" — günlük saat aralığı (opsiyonel)
  availableTo  String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  products     Product[]             @relation("ProductCategory")
  subProducts  Product[]             @relation("ProductSubcategory")
  translations CategoryTranslation[]
  campaigns    Campaign[]

  @@index([parentId, sortOrder])
  @@map("categories")
}

model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale      String
  name        String
  description String?

  @@unique([categoryId, locale])
  @@map("category_translations")
}

model Product {
  id            String               @id @default(cuid())
  slug          String               @unique
  name          String
  description   String?
  ingredients   String?
  price         Decimal              @db.Decimal(10, 2)
  oldPrice      Decimal?             @db.Decimal(10, 2)
  campaignPrice Decimal?             @db.Decimal(10, 2)
  categoryId    String
  category      Category             @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId String?
  subcategory   Category?            @relation("ProductSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  calories      Int?
  portion       String? // gramaj
  prepMinutes   Int?
  spiceLevel    Int                  @default(0) // 0-3
  vegetarian    Boolean              @default(false)
  vegan         Boolean              @default(false)
  glutenFree    Boolean              @default(false)
  featured      Boolean              @default(false)
  isNew         Boolean              @default(false)
  popular       Boolean              @default(false)
  daily         Boolean              @default(false)
  tags          String[]             @default([])
  active        Boolean              @default(true)
  inStock       Boolean              @default(true)
  sortOrder     Int                  @default(0)
  seoTitle      String?
  seoDescription String?
  viewCount     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  images        ProductImage[]
  translations  ProductTranslation[]
  allergens     ProductAllergen[]
  orderItems    OrderItem[]

  @@index([categoryId, sortOrder])
  @@index([active, featured])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductTranslation {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale      String // en | de
  name        String
  description String?
  ingredients String?

  @@unique([productId, locale])
  @@map("product_translations")
}

model Allergen {
  id        String            @id @default(cuid())
  key       String            @unique
  nameTr    String
  nameEn    String
  nameDe    String
  icon      String?
  sortOrder Int               @default(0)
  products  ProductAllergen[]

  @@map("allergens")
}

model ProductAllergen {
  productId  String
  allergenId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@id([productId, allergenId])
  @@map("product_allergens")
}

// ───────────────────────── Masalar & QR ─────────────────────────

model Table {
  id        String   @id @default(cuid())
  number    Int      @unique
  name      String?
  area      String? // Bahçe, Çardak, İç Salon...
  capacity  Int      @default(4)
  active    Boolean  @default(true)
  orderToken String  @unique @default(cuid())
  createdAt DateTime @default(now())
  qrCodes   QrCode[]
  orders    Order[]

  @@map("tables")
}

model QrCode {
  id        String   @id @default(cuid())
  code      String   @unique // kısa kod: /q/{code}
  label     String
  type      String // table | general | custom
  tableId   String?
  table     Table?   @relation(fields: [tableId], references: [id], onDelete: Cascade)
  targetPath String  @default("/menu")
  active    Boolean  @default(true)
  scanCount Int      @default(0)
  lastScanAt DateTime?
  createdAt DateTime @default(now())
  scans     QrScan[]

  @@index([tableId])
  @@map("qr_codes")
}

model QrScan {
  id        String   @id @default(cuid())
  qrCodeId  String
  qrCode    QrCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  device    String?
  userAgent String?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([qrCodeId, createdAt])
  @@index([createdAt])
  @@map("qr_scans")
}

// ───────────────────────── Siparişler ─────────────────────────

model Order {
  id            String      @id @default(cuid())
  number        Int         @default(autoincrement()) @unique
  publicId      String      @unique @default(cuid())
  tableId       String?
  table         Table?      @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableNumber   Int?
  status        String      @default("new") // new | preparing | ready | delivered | cancelled
  note          String?
  customerName  String?
  subtotal      Decimal     @db.Decimal(10, 2)
  taxAmount     Decimal     @default(0) @db.Decimal(10, 2)
  total         Decimal     @db.Decimal(10, 2)
  currency      String      @default("TRY")
  paymentStatus String      @default("unpaid") // unpaid | pending | paid | refunded
  paymentMethod String? // cash | card_at_table | online
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
  payments      Payment[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  unitPrice   Decimal  @db.Decimal(10, 2)
  quantity    Int
  note        String?
  lineTotal   Decimal  @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// Online ödeme için hazır altyapı (sağlayıcı bağımsız)
model Payment {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String // manual | iyzico | stripe | paytr ...
  providerRef String?
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("TRY")
  status      String   @default("pending") // pending | succeeded | failed | refunded
  raw         Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@map("payments")
}

// ───────────────────────── Rezervasyon ─────────────────────────

model Reservation {
  id             String            @id @default(cuid())
  code           String            @unique
  name           String
  phone          String
  email          String?
  guests         Int
  children       Int               @default(0)
  date           DateTime          @db.Date
  time           String // "19:30"
  seating        String?
  occasion       String? // birthday | celebration | anniversary | ...
  specialRequest String?
  description    String?
  status         String            @default("pending") // pending | confirmed | rejected | cancelled | completed | no_show
  source         String            @default("web") // web | phone | walk_in | admin
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  notes          ReservationNote[]

  @@index([date, status])
  @@index([phone])
  @@index([createdAt])
  @@map("reservations")
}

model ReservationNote {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  body          String
  createdAt     DateTime    @default(now())

  @@index([reservationId])
  @@map("reservation_notes")
}

// ───────────────────────── Organizasyon ─────────────────────────

model Event {
  id          String         @id @default(cuid())
  key         String         @unique
  name        String
  description String?
  image       String?
  sortOrder   Int            @default(0)
  active      Boolean        @default(true)
  requests    EventRequest[]

  @@map("events")
}

model EventRequest {
  id          String             @id @default(cuid())
  code        String             @unique
  eventId     String?
  event       Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventType   String
  name        String
  phone       String
  email       String?
  date        DateTime?          @db.Date
  guests      Int?
  budget      String?
  specialRequest String?
  description String?
  status      String             @default("new") // new | contacted | quoted | approved | rejected | completed
  quoteAmount Decimal?           @db.Decimal(12, 2)
  quoteDetails String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  notes       EventRequestNote[]

  @@index([status, createdAt])
  @@index([date])
  @@map("event_requests")
}

model EventRequestNote {
  id        String       @id @default(cuid())
  requestId String
  request   EventRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime     @default(now())

  @@index([requestId])
  @@map("event_request_notes")
}

// ───────────────────────── Galeri ─────────────────────────

model GalleryCategory {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  sortOrder Int           @default(0)
  items     GalleryItem[]

  @@map("gallery_categories")
}

model GalleryItem {
  id          String           @id @default(cuid())
  type        String           @default("image") // image | video
  url         String
  thumbUrl    String?
  width       Int?
  height      Int?
  title       String?
  description String?
  alt         String?
  categoryId  String?
  category    GalleryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  showOnHome  Boolean          @default(false)
  active      Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())

  @@index([categoryId, sortOrder])
  @@index([showOnHome])
  @@map("gallery")
}

// ───────────────────────── Kampanya & Yorum & İletişim ─────────────────────────

model Campaign {
  id            String    @id @default(cuid())
  title         String
  description   String?
  image         String?
  startsAt      DateTime?
  endsAt        DateTime?
  price         Decimal?  @db.Decimal(10, 2)
  discountRate  Int?
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  active        Boolean   @default(true)
  showOnHome    Boolean   @default(true)
  showOnMenu    Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([active, startsAt, endsAt])
  @@map("campaigns")
}

model Review {
  id         String   @id @default(cuid())
  authorName String
  rating     Int
  body       String
  date       DateTime @db.Date
  photo      String?
  source     String   @default("google") // google | manual
  sourceUrl  String?
  featured   Boolean  @default(false)
  visible    Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([visible, featured])
  @@map("reviews")
}

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  email     String?
  subject   String?
  message   String
  status    String    @default("unread") // unread | read | replied
  archived  Boolean   @default(false)
  ip        String?
  repliedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([status, archived, createdAt])
  @@map("contact_messages")
}

model Notification {
  id        String   @id @default(cuid())
  type      String // reservation | order | event | message | system
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
  @@map("notifications")
}

// Müşteriye giden bildirim kayıtları (e-posta / SMS / WhatsApp sağlayıcılarına hazır)
model OutboundMessage {
  id        String   @id @default(cuid())
  channel   String // email | sms | whatsapp
  to        String
  subject   String?
  body      String
  status    String   @default("queued") // queued | sent | failed | skipped
  error     String?
  entity    String?
  entityId  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("outbound_messages")
}

// ───────────────────────── Analitik ─────────────────────────

model AnalyticsEvent {
  id         String   @id @default(cuid())
  type       String // pageview | menu_view | product_view | category_view | qr_scan | reservation | event_request | order | contact
  path       String?
  entityId   String?
  entityName String?
  sessionId  String?
  device     String? // mobile | tablet | desktop
  source     String? // direct | qr | google | instagram | facebook | referral
  referrer   String?
  createdAt  DateTime @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
  @@index([entityId])
  @@map("analytics")
}

// Yüklenen medya dosyaları (Cloudflare gibi disksiz ortamlarda veritabanında saklanır)
model StoredFile {
  id        String   @id @default(cuid())
  path      String   @unique // ör. "2026/11/abc.webp" → /uploads/2026/11/abc.webp
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@map("files")
}
